{
  "name": "wallt",
  "private": true,
  "description": "Self-hosted personal finance & budget tracker",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmgoliveira/wallt.git"
  },
  "homepage": "https://github.com/fmgoliveira/wallt#readme",
  "bugs": "https://github.com/fmgoliveira/wallt/issues",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "e2e": "pnpm --filter @wallt/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "version": "1.2.1"
}
