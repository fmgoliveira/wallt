{
  "expo": {
    "name": "Wallt",
    "slug": "wallt",
    "scheme": "wallt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "android": {
      "package": "app.wallt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2b2780"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "releasesUrl": "https://github.com/fmgoliveira/wallt/releases"
    }
  }
}
