{
  "expo": {
    "name": "Wallt",
    "slug": "wallt",
    "scheme": "wallt",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "android": {
      "package": "app.wallt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f2f2f2",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "releasesUrl": "https://github.com/fmgoliveira/wallt/releases"
    }
  }
}
