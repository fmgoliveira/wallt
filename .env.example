# Copy to .env next to docker-compose.yml. Never commit .env.
PORT=3000
TZ=Europe/Lisbon
LOG_LEVEL=info
APP_URL=https://wallt.franciscoliveira.com
# REQUIRED: master secret (TOTP secrets are encrypted with it, JWT key derived from it).
# Generate with: openssl rand -base64 32   -- losing it locks everyone out; back it up separately.
ENCRYPTION_KEY=
# One-time guard for creating the first user (>= 16 chars, e.g. openssl rand -hex 16).
# Set it for the first start only, create the account, then remove it.
SETUP_TOKEN=
# Peers whose X-Real-IP is trusted (host nginx via the Docker bridge gateway).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
